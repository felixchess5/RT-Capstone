# Copy to .env in the same folder as docker-compose.yml
# At least one provider key is required.

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Assignment Grader

# Optional demo settings
GRADIO_SHARE=false
GRADIO_SERVER_PORT=7860
BACKEND_CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860

# Optional: branch or tag to run from GitHub
APP_GIT_REF=main
